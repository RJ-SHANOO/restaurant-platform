// =============================================================================
//  Restaurant Platform — database schema
//
//  Every tenant-owned table carries restaurantId. Tables that belong to one
//  outlet also carry branchId. That pair is what keeps one restaurant's data
//  invisible to another, and it is enforced in code by the tenant guard in
//  src/config/prisma.ts rather than left to each query to remember.
//
//  Money is Decimal, never Float. Float cannot represent 0.1 exactly, and a
//  rounding drift of a fraction of a rupee per line becomes a bill that does
//  not add up.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
//  TENANCY
// =============================================================================

enum RestaurantStatus {
  pending
  active
  suspended
  closed
}

enum CommissionType {
  percentage
  fixed
}

enum SettlementFrequency {
  daily
  every_2_days
  weekly
  monthly
}

// Drives CommissionRun windowing (see PLATFORM REVENUE below). Distinct from
// SettlementFrequency, which only controls how far back a manually-triggered
// settlement looks - the cycle is what actually buckets commission entries.
enum CommissionCycle {
  daily
  every_3d
  weekly
}

model Restaurant {
  id           Int              @id @default(autoincrement())
  name         String           @db.VarChar(150)
  slug         String           @unique @db.VarChar(160)
  contactEmail String           @map("contact_email") @db.VarChar(150)
  contactPhone String           @map("contact_phone") @db.VarChar(30)
  addressLine  String?          @map("address_line") @db.VarChar(255)
  city         String?          @db.VarChar(80)
  logoPath     String?          @map("logo_path") @db.VarChar(255)
  currencyCode String           @default("PKR") @map("currency_code") @db.VarChar(3)
  timezone     String           @default("Asia/Karachi") @db.VarChar(64)
  status       RestaurantStatus @default(pending)

  // Commercial terms, fixed at registration from config. Stored per restaurant
  // so a negotiated rate is possible and so changing the platform default
  // never rewrites what an existing restaurant agreed to.
  commissionType      CommissionType      @default(percentage) @map("commission_type")
  commissionValue     Decimal             @default(0) @map("commission_value") @db.Decimal(10, 2)
  settlementFrequency SettlementFrequency @default(weekly) @map("settlement_frequency")
  termsAgreedAt       DateTime?           @map("terms_agreed_at")

  // The cycle a commission run is windowed by, and the date its boundaries
  // are counted from. Changing the cycle moves the anchor to the next
  // boundary rather than re-slicing runs already computed under the old one.
  commissionCycle CommissionCycle @default(weekly) @map("commission_cycle")
  cycleAnchorDate DateTime        @default(now()) @map("cycle_anchor_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches          Branch[]
  users             User[]
  roles             Role[]
  categories        Category[]
  products          Product[]
  modifierGroups    ModifierGroup[]
  diningTables      DiningTable[]
  customers         Customer[]
  orders            Order[]
  invoices          Invoice[]
  payments          Payment[]
  refunds           Refund[]
  paymentMethods    PaymentMethod[]
  commissionEntries CommissionEntry[]
  commissionRuns    CommissionRun[]
  settlements       Settlement[]
  inventoryItems    InventoryItem[]
  suppliers         Supplier[]
  purchases         Purchase[]
  expenses          Expense[]
  settings          Setting[]
  devices           Device[]
  auditLogs         AuditLog[]
  website           RestaurantWebsite?
  kitchenStations   KitchenStation[]

  @@index([status, city])
  @@map("restaurants")
}

enum BranchStatus {
  active
  inactive
}

model Branch {
  id           Int    @id @default(autoincrement())
  restaurantId Int    @map("restaurant_id")
  name         String @db.VarChar(120)
  code         String @db.VarChar(20)

  addressLine String? @map("address_line") @db.VarChar(255)
  city        String? @db.VarChar(80)
  phone       String? @db.VarChar(30)

  // Coordinates so a branch can be shown on the restaurant's public site.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  openingTime String? @map("opening_time") @db.VarChar(5)
  closingTime String? @map("closing_time") @db.VarChar(5)

  taxPercentage           Decimal @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  serviceChargePercentage Decimal @default(0) @map("service_charge_percentage") @db.Decimal(5, 2)

  // How long the kitchen typically takes on this branch. Used only to give a
  // QR customer a rough countdown after their order is confirmed - not a
  // promise, just an estimate the restaurant can tune.
  estimatedPrepMinutes Int @default(20) @map("estimated_prep_minutes")

  acceptsQrOrders Boolean @default(true) @map("accepts_qr_orders")
  acceptsDelivery Boolean @default(false) @map("accepts_delivery")
  acceptsTakeaway Boolean @default(true) @map("accepts_takeaway")

  status    BranchStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  users           User[]
  diningTables    DiningTable[]
  orders          Order[]
  kitchenStations KitchenStation[]
  inventoryLevels BranchInventoryLevel[]
  inventoryTxns   InventoryTransaction[]
  invoices        Invoice[]
  purchases       Purchase[]
  expenses        Expense[]
  devices         Device[]
  branchProducts  BranchProduct[]

  @@unique([restaurantId, code])
  @@index([restaurantId, status])
  @@map("branches")
}

// =============================================================================
//  ACCESS
// =============================================================================

enum UserStatus {
  active
  suspended
}

model User {
  id           Int  @id @default(autoincrement())
  restaurantId Int? @map("restaurant_id") // null = platform administrator
  branchId     Int? @map("branch_id") // null = unbound, sees all branches

  fullName String  @map("full_name") @db.VarChar(150)
  email    String  @db.VarChar(150)
  phone    String? @db.VarChar(30)
  password String  @db.VarChar(255)

  avatarPath  String?    @map("avatar_path") @db.VarChar(255)
  status      UserStatus @default(active)
  lastLoginAt DateTime?  @map("last_login_at")
  lastLoginIp String?    @map("last_login_ip") @db.VarChar(45)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  roles         UserRole[]
  statusHistory OrderStatusHistory[]
  auditLogs     AuditLog[]

  // Email is unique per tenant, not globally: one person can hold an account
  // at two different restaurants. Platform admins (restaurantId null) are
  // handled by a partial index created in migration SQL.
  @@unique([restaurantId, email])
  @@index([email])
  @@map("users")
}

model Role {
  id           Int     @id @default(autoincrement())
  restaurantId Int?    @map("restaurant_id") // null = system role, available to all
  name         String  @db.VarChar(80)
  slug         String  @db.VarChar(80)
  description  String? @db.VarChar(255)
  isSystem     Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant  Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([restaurantId, slug])
  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  slug        String  @unique @db.VarChar(80)
  name        String  @db.VarChar(120)
  groupName   String  @map("group_name") @db.VarChar(60)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("role_user")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("permission_role")
}

// =============================================================================
//  PUBLIC WEBSITE
// =============================================================================

model RestaurantWebsite {
  id           Int @id @default(autoincrement())
  restaurantId Int @unique @map("restaurant_id")

  isPublished  Boolean @default(false) @map("is_published")
  customDomain String? @unique @map("custom_domain") @db.VarChar(190)

  // Theme. Held as discrete columns rather than a JSON blob so a bad value
  // can be validated on the way in and a colour can be queried or reported on.
  primaryColor    String @default("#F5A524") @map("primary_color") @db.VarChar(9)
  secondaryColor  String @default("#3DD68C") @map("secondary_color") @db.VarChar(9)
  backgroundShade String @default("dark") @map("background_shade") @db.VarChar(10)
  fontFamily      String @default("Inter") @map("font_family") @db.VarChar(60)
  layoutStyle     String @default("classic") @map("layout_style") @db.VarChar(20)

  logoUrl   String? @map("logo_url") @db.VarChar(500)
  bannerUrl String? @map("banner_url") @db.VarChar(500)

  tagline       String? @db.VarChar(200)
  aboutText     String? @map("about_text")
  facebookUrl   String? @map("facebook_url") @db.VarChar(255)
  instagramUrl  String? @map("instagram_url") @db.VarChar(255)
  whatsappPhone String? @map("whatsapp_phone") @db.VarChar(30)

  showMenu         Boolean @default(true) @map("show_menu")
  showBranches     Boolean @default(true) @map("show_branches")
  allowOnlineOrder Boolean @default(false) @map("allow_online_order")

  // ------------------------------------------------------------------ header
  logoPosition    String  @default("left") @map("logo_position") @db.VarChar(10) // left | center
  headerSticky    Boolean @default(true) @map("header_sticky")
  showHeaderPhone Boolean @default(false) @map("show_header_phone")
  orderNowText    String  @default("Order Now") @map("order_now_text") @db.VarChar(40)
  orderNowTarget  String  @default("menu") @map("order_now_target") @db.VarChar(20) // menu | whatsapp | branches | custom
  orderNowUrl     String? @map("order_now_url") @db.VarChar(500) // only read when orderNowTarget = custom

  // A restaurant-managed list, so held as JSON rather than its own table -
  // there is nothing to query it by. Each entry is { label, url }.
  headerNavLinks Json @default("[]") @map("header_nav_links")

  // ------------------------------------------------------------------ footer
  footerAboutText     String? @map("footer_about_text") @db.VarChar(300)
  footerHours         String? @map("footer_hours") @db.VarChar(200)
  footerCopyrightText String? @map("footer_copyright_text") @db.VarChar(200)
  footerLayout        String  @default("simple") @map("footer_layout") @db.VarChar(20) // simple | columns | minimal

  // -------------------------------------------------------------------- home
  heroHeading    String? @map("hero_heading") @db.VarChar(150)
  heroButtonText String  @default("Order Now") @map("hero_button_text") @db.VarChar(40)

  showFeaturedProducts  Boolean @default(true) @map("show_featured_products")
  featuredProductsLimit Int     @default(4) @map("featured_products_limit")
  showAboutSection      Boolean @default(true) @map("show_about_section")

  // The order home page sections render in. A fixed vocabulary of section
  // keys, so held as JSON rather than one column per position.
  homeSectionOrder Json @default("[\"hero\", \"featured\", \"about\", \"branches\"]") @map("home_section_order")

  // -------------------------------------------------------------------- shop
  shopViewStyle          String  @default("grid") @map("shop_view_style") @db.VarChar(10) // grid | list
  shopItemsPerRow        Int     @default(3) @map("shop_items_per_row")
  shopShowPrice          Boolean @default(true) @map("shop_show_price")
  shopShowCategoryFilter Boolean @default(true) @map("shop_show_category_filter")
  shopShowSearch         Boolean @default(true) @map("shop_show_search")
  shopShowProductImage   Boolean @default(true) @map("shop_show_product_image")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_websites")
}

// =============================================================================
//  CATALOG
// =============================================================================

model Category {
  id           Int     @id @default(autoincrement())
  restaurantId Int     @map("restaurant_id")
  parentId     Int?    @map("parent_id")
  name         String  @db.VarChar(120)
  slug         String  @db.VarChar(140)
  description  String? @db.VarChar(255)
  imageUrl     String? @map("image_url") @db.VarChar(500)
  sortOrder    Int     @default(0) @map("sort_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parent     Category?                @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]               @relation("CategoryTree")
  products   Product[]
  stations   CategoryKitchenStation[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive])
  @@map("categories")
}

model Product {
  id           Int @id @default(autoincrement())
  restaurantId Int @map("restaurant_id")
  categoryId   Int @map("category_id")

  name        String  @db.VarChar(150)
  slug        String  @db.VarChar(170)
  description String? @db.VarChar(500)
  imageUrl    String? @map("image_url") @db.VarChar(500)

  basePrice Decimal @map("base_price") @db.Decimal(10, 2)

  preparationMinutes Int     @default(10) @map("preparation_minutes")
  tracksInventory    Boolean @default(false) @map("tracks_inventory")
  isAvailable        Boolean @default(true) @map("is_available")
  isFeatured         Boolean @default(false) @map("is_featured")
  sortOrder          Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant      Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  modifierGroups  ProductModifierGroup[]
  branchOverrides BranchProduct[]
  recipeItems     ProductRecipeItem[]
  orderItems      OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, categoryId, isAvailable])
  @@map("products")
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int     @map("product_id")
  name       String  @db.VarChar(80)
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  isDefault  Boolean @default(false) @map("is_default")
  sortOrder  Int     @default(0) @map("sort_order")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

enum ModifierSelectionType {
  single
  multiple
}

model ModifierGroup {
  id            Int                   @id @default(autoincrement())
  restaurantId  Int                   @map("restaurant_id")
  name          String                @db.VarChar(120)
  selectionType ModifierSelectionType @default(single) @map("selection_type")
  minSelections Int                   @default(0) @map("min_selections")
  maxSelections Int                   @default(1) @map("max_selections")
  isRequired    Boolean               @default(false) @map("is_required")

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  products   ProductModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id              Int     @id @default(autoincrement())
  modifierGroupId Int     @map("modifier_group_id")
  name            String  @db.VarChar(120)
  priceDelta      Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  isAvailable     Boolean @default(true) @map("is_available")
  sortOrder       Int     @default(0) @map("sort_order")

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@map("modifiers")
}

model ProductModifierGroup {
  productId       Int @map("product_id")
  modifierGroupId Int @map("modifier_group_id")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("modifier_group_product")
}

model BranchProduct {
  branchId      Int      @map("branch_id")
  productId     Int      @map("product_id")
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  isAvailable   Boolean  @default(true) @map("is_available")

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  @@map("branch_product")
}

// =============================================================================
//  SERVICE FLOOR
// =============================================================================

enum TableStatus {
  available
  occupied
  reserved
  out_of_service
}

model DiningTable {
  id           Int         @id @default(autoincrement())
  restaurantId Int         @map("restaurant_id")
  branchId     Int         @map("branch_id")
  label        String      @db.VarChar(40)
  capacity     Int         @default(4)
  areaName     String?     @map("area_name") @db.VarChar(60)
  status       TableStatus @default(available)

  // Opaque and rotatable. The token is the credential a scanning customer
  // presents; rotating it invalidates every printed code for this table.
  qrToken String @unique @map("qr_token") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([branchId, label])
  @@map("dining_tables")
}

model Customer {
  id           Int     @id @default(autoincrement())
  restaurantId Int     @map("restaurant_id")
  fullName     String  @map("full_name") @db.VarChar(150)
  phone        String  @db.VarChar(30)
  email        String? @db.VarChar(150)
  addressLine  String? @map("address_line") @db.VarChar(255)
  notes        String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, phone])
  @@map("customers")
}

// =============================================================================
//  ORDERS
// =============================================================================

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum OrderChannel {
  pos
  qr
  website
  phone
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  served
  completed
  cancelled
  voided
}

enum PaymentStatus {
  unpaid
  partial
  paid
  refunded
}

model Order {
  id           Int @id @default(autoincrement())
  restaurantId Int @map("restaurant_id")
  branchId     Int @map("branch_id")

  orderNumber   String @map("order_number") @db.VarChar(40)
  diningTableId Int?   @map("dining_table_id")
  customerId    Int?   @map("customer_id")

  orderType     OrderType     @default(dine_in) @map("order_type")
  channel       OrderChannel  @default(pos)
  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")

  guestCount   Int?    @map("guest_count")
  customerNote String? @map("customer_note") @db.VarChar(500)
  cancelReason String? @map("cancel_reason") @db.VarChar(255)

  // What a QR customer said they intend to pay with, captured at order time
  // so the bill the waiter brings can already show it pre-selected. It is a
  // stated intent, not a charge - the actual Payment row is still created
  // separately when money is taken, and can use a different method.
  preferredPaymentMethodId Int? @map("preferred_payment_method_id")

  // Set once the order is confirmed: confirmedAt + the branch's
  // estimatedPrepMinutes. Lets a QR customer poll "how much longer" without
  // the kitchen doing anything different.
  estimatedReadyAt DateTime? @map("estimated_ready_at")

  // Receipt snapshots, frozen at creation like everything else below - a table
  // renamed or a shift-change after the fact must never change what a reprint
  // shows. tokenNumber is the short per-branch, per-day counter called out at
  // pickup; tableNumber is the dining table's label copied in, not joined.
  tokenNumber    Int?    @map("token_number")
  tableNumber    String? @map("table_number") @db.VarChar(40)
  orderTakerName String? @map("order_taker_name") @db.VarChar(150)

  // Frozen snapshots. A later menu price change never rewrites an order that
  // has already been placed.
  subtotal             Decimal @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  serviceChargePercent Decimal @default(0) @map("service_charge_percent") @db.Decimal(5, 2)
  serviceCharge        Decimal @default(0) @map("service_charge") @db.Decimal(12, 2)
  taxAmount            Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  deliveryFee          Decimal @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  tipAmount            Decimal @default(0) @map("tip_amount") @db.Decimal(12, 2)
  grandTotal           Decimal @default(0) @map("grand_total") @db.Decimal(12, 2)

  // A replayed key returns the original order instead of creating a second
  // one. This is what makes an offline queue safe to flush twice.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(64)

  // The restaurant's calendar day the order was placed on, frozen at
  // creation from the branch's timezone. Commission runs join on this, not
  // createdAt, so a bill settled after midnight still lands in the cycle the
  // order actually happened in.
  businessDate DateTime @map("business_date") @db.Date

  placedAt    DateTime  @default(now()) @map("placed_at")
  confirmedAt DateTime? @map("confirmed_at")
  readyAt     DateTime? @map("ready_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant             Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch                 Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningTable            DiningTable?   @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  customer               Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  preferredPaymentMethod PaymentMethod? @relation(fields: [preferredPaymentMethodId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  kitchenTickets KitchenTicket[]
  invoice        Invoice?

  @@unique([restaurantId, orderNumber])
  @@unique([branchId, idempotencyKey])
  @@index([restaurantId, branchId, status, createdAt])
  @@index([branchId, placedAt])
  @@map("orders")
}

model OrderItem {
  id      Int @id @default(autoincrement())
  orderId Int @map("order_id")

  productId        Int  @map("product_id")
  productVariantId Int? @map("product_variant_id")

  // Copied, not joined. A receipt must still read correctly in five years,
  // even if the dish has since been renamed or deleted from the menu.
  productName String  @map("product_name") @db.VarChar(150)
  variantName String? @map("variant_name") @db.VarChar(80)

  quantity          Int     @default(1)
  cancelledQuantity Int     @default(0) @map("cancelled_quantity")
  unitPrice         Decimal @map("unit_price") @db.Decimal(10, 2)
  modifierTotal     Decimal @default(0) @map("modifier_total") @db.Decimal(10, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)

  modifierSummary String? @map("modifier_summary") @db.VarChar(500)
  kitchenNote     String? @map("kitchen_note") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  ticketItems KitchenTicketItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id      Int @id @default(autoincrement())
  orderId Int @map("order_id")

  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String?      @db.VarChar(255)
  changedBy  Int?         @map("changed_by")

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

// =============================================================================
//  KITCHEN
// =============================================================================

enum TicketStatus {
  queued
  preparing
  ready
  served
  cancelled
}

enum TicketPriority {
  normal
  rush
}

model KitchenStation {
  id           Int     @id @default(autoincrement())
  restaurantId Int     @map("restaurant_id")
  branchId     Int     @map("branch_id")
  name         String  @db.VarChar(80)
  printerName  String? @map("printer_name") @db.VarChar(120)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categories CategoryKitchenStation[]
  tickets    KitchenTicket[]

  @@unique([branchId, name])
  @@map("kitchen_stations")
}

model CategoryKitchenStation {
  categoryId       Int @map("category_id")
  kitchenStationId Int @map("kitchen_station_id")

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  station  KitchenStation @relation(fields: [kitchenStationId], references: [id], onDelete: Cascade)

  @@id([categoryId, kitchenStationId])
  @@map("category_kitchen_station")
}

// No money columns anywhere in this model or the next. Not as a display
// choice - the fields do not exist, so no template change can leak a price
// onto the pass.
model KitchenTicket {
  id               Int  @id @default(autoincrement())
  restaurantId     Int  @map("restaurant_id")
  branchId         Int  @map("branch_id")
  orderId          Int  @map("order_id")
  kitchenStationId Int? @map("kitchen_station_id")

  ticketNumber String         @map("ticket_number") @db.VarChar(40)
  status       TicketStatus   @default(queued)
  priority     TicketPriority @default(normal)

  tableLabel     String? @map("table_label") @db.VarChar(40)
  orderTypeLabel String? @map("order_type_label") @db.VarChar(20)
  note           String? @db.VarChar(500)

  targetMinutes Int       @default(15) @map("target_minutes")
  startedAt     DateTime? @map("started_at")
  readyAt       DateTime? @map("ready_at")
  printedAt     DateTime? @map("printed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station KitchenStation?     @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  items   KitchenTicketItem[]

  @@index([branchId, status, createdAt])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id              Int @id @default(autoincrement())
  kitchenTicketId Int @map("kitchen_ticket_id")
  orderItemId     Int @map("order_item_id")

  productName String  @map("product_name") @db.VarChar(150)
  variantName String? @map("variant_name") @db.VarChar(80)
  quantity    Int     @default(1)
  note        String? @db.VarChar(255)
  isDone      Boolean @default(false) @map("is_done")

  ticket    KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("kitchen_ticket_items")
}

// =============================================================================
//  INVENTORY  —  a ledger, not a counter
// =============================================================================

model InventoryItem {
  id           Int     @id @default(autoincrement())
  restaurantId Int     @map("restaurant_id")
  name         String  @db.VarChar(150)
  sku          String? @db.VarChar(60)
  unit         String  @default("kg") @db.VarChar(20)
  reorderLevel Decimal @default(0) @map("reorder_level") @db.Decimal(12, 3)
  costPerUnit  Decimal @default(0) @map("cost_per_unit") @db.Decimal(10, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  levels        BranchInventoryLevel[]
  transactions  InventoryTransaction[]
  recipeItems   ProductRecipeItem[]
  purchaseItems PurchaseItem[]

  @@unique([restaurantId, name])
  @@map("inventory_items")
}

model ProductRecipeItem {
  id              Int     @id @default(autoincrement())
  productId       Int     @map("product_id")
  inventoryItemId Int     @map("inventory_item_id")
  quantityPerUnit Decimal @map("quantity_per_unit") @db.Decimal(12, 4)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryItemId])
  @@map("product_recipe_items")
}

// A cached projection of the ledger. If it ever drifts, replaying
// inventory_transactions rebuilds it exactly.
model BranchInventoryLevel {
  branchId        Int     @map("branch_id")
  inventoryItemId Int     @map("inventory_item_id")
  quantity        Decimal @default(0) @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([branchId, inventoryItemId])
  @@map("branch_inventory_levels")
}

enum InventoryTxnType {
  purchase
  sale
  adjustment
  wastage
  transfer_in
  transfer_out
  reversal
}

// Append-only. Nothing here is ever updated or deleted; a correction is a new
// row with the opposite sign.
model InventoryTransaction {
  id              Int              @id @default(autoincrement())
  restaurantId    Int              @map("restaurant_id")
  branchId        Int              @map("branch_id")
  inventoryItemId Int              @map("inventory_item_id")
  type            InventoryTxnType

  quantityDelta Decimal @map("quantity_delta") @db.Decimal(14, 3)
  balanceAfter  Decimal @map("balance_after") @db.Decimal(14, 3)
  unitCost      Decimal @default(0) @map("unit_cost") @db.Decimal(10, 2)

  // Polymorphic source: an Order, a Purchase, or a manual adjustment.
  sourceType String? @map("source_type") @db.VarChar(40)
  sourceId   Int?    @map("source_id")
  note       String? @db.VarChar(255)
  createdBy  Int?    @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([branchId, inventoryItemId, createdAt])
  @@map("inventory_transactions")
}

model Supplier {
  id           Int     @id @default(autoincrement())
  restaurantId Int     @map("restaurant_id")
  name         String  @db.VarChar(150)
  contactName  String? @map("contact_name") @db.VarChar(120)
  phone        String? @db.VarChar(30)
  email        String? @db.VarChar(150)
  addressLine  String? @map("address_line") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchases  Purchase[]

  @@map("suppliers")
}

enum PurchaseStatus {
  draft
  received
  cancelled
}

model Purchase {
  id             Int            @id @default(autoincrement())
  restaurantId   Int            @map("restaurant_id")
  branchId       Int            @map("branch_id")
  supplierId     Int?           @map("supplier_id")
  purchaseNumber String         @map("purchase_number") @db.VarChar(40)
  status         PurchaseStatus @default(draft)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  receivedAt     DateTime?      @map("received_at")
  note           String?        @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items      PurchaseItem[]

  @@unique([restaurantId, purchaseNumber])
  @@map("purchases")
}

model PurchaseItem {
  id              Int     @id @default(autoincrement())
  purchaseId      Int     @map("purchase_id")
  inventoryItemId Int     @map("inventory_item_id")
  quantity        Decimal @db.Decimal(14, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(10, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)

  purchase Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@map("purchase_items")
}

// =============================================================================
//  MONEY
// =============================================================================

model PaymentMethod {
  id           Int    @id @default(autoincrement())
  restaurantId Int    @map("restaurant_id")
  name         String @db.VarChar(80)
  code         String @db.VarChar(40)
  kind         String @default("cash") @db.VarChar(20) // cash | card | wallet | bank | online

  requiresReference Boolean @default(false) @map("requires_reference")
  accountTitle      String? @map("account_title") @db.VarChar(120)
  accountNumber     String? @map("account_number") @db.VarChar(60)
  qrImageUrl        String? @map("qr_image_url") @db.VarChar(500)
  instructions      String? @db.VarChar(500)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments          Payment[]
  preferredByOrders Order[]

  @@unique([restaurantId, code])
  @@map("payment_methods")
}

enum InvoiceStatus {
  issued
  paid
  partially_refunded
  refunded
  void
}

model Invoice {
  id            Int           @id @default(autoincrement())
  restaurantId  Int           @map("restaurant_id")
  branchId      Int           @map("branch_id")
  orderId       Int           @unique @map("order_id")
  invoiceNumber String        @map("invoice_number") @db.VarChar(40)
  status        InvoiceStatus @default(issued)

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  serviceCharge  Decimal @default(0) @map("service_charge") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @map("grand_total") @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)
  refundedAmount Decimal @default(0) @map("refunded_amount") @db.Decimal(12, 2)

  qrPayload  String?   @map("qr_payload") @db.VarChar(500)
  issuedAt   DateTime  @default(now()) @map("issued_at")
  paidAt     DateTime? @map("paid_at")
  voidedAt   DateTime? @map("voided_at")
  voidReason String?   @map("void_reason") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments   Payment[]
  refunds    Refund[]
  commission CommissionEntry[]

  @@unique([restaurantId, invoiceNumber])
  @@index([branchId, issuedAt])
  @@map("invoices")
}

enum PaymentState {
  captured
  reversed
}

// Never deleted. A mistaken payment is superseded by a refund row.
model Payment {
  id              Int          @id @default(autoincrement())
  restaurantId    Int          @map("restaurant_id")
  invoiceId       Int          @map("invoice_id")
  paymentMethodId Int          @map("payment_method_id")
  amount          Decimal      @db.Decimal(12, 2)
  tenderedAmount  Decimal?     @map("tendered_amount") @db.Decimal(12, 2)
  changeAmount    Decimal      @default(0) @map("change_amount") @db.Decimal(12, 2)
  reference       String?      @db.VarChar(120)
  state           PaymentState @default(captured)
  receivedBy      Int?         @map("received_by")

  // Lets a retried "mark as paid" request return the payment it already made
  // instead of erroring or double-charging - the same replay guard Order uses
  // for idempotencyKey.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method     PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, idempotencyKey])
  @@index([invoiceId])
  @@map("payments")
}

model Refund {
  id                 Int     @id @default(autoincrement())
  restaurantId       Int     @map("restaurant_id")
  invoiceId          Int     @map("invoice_id")
  amount             Decimal @db.Decimal(12, 2)
  reasonCode         String  @map("reason_code") @db.VarChar(40)
  reasonNote         String? @map("reason_note") @db.VarChar(255)
  restockedInventory Boolean @default(false) @map("restocked_inventory")
  issuedBy           Int?    @map("issued_by")

  // Lets a retried refund request return the refund it already made instead
  // of erroring or, worse, giving the money back twice - the same replay
  // guard Payment uses for idempotencyKey.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, idempotencyKey])
  @@index([invoiceId])
  @@map("refunds")
}

model Expense {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  branchId     Int?     @map("branch_id")
  category     String   @db.VarChar(60)
  description  String   @db.VarChar(255)
  amount       Decimal  @db.Decimal(12, 2)
  incurredOn   DateTime @map("incurred_on") @db.Date
  recordedBy   Int?     @map("recorded_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([restaurantId, incurredOn])
  @@map("expenses")
}

// =============================================================================
//  PLATFORM REVENUE
// =============================================================================

enum CommissionEntryType {
  charge
  reversal
}

enum CommissionEntryStatus {
  pending
  settled
}

// Immutable ledger. A refund does not edit the original charge; it writes a
// negative reversal that nets against it.
model CommissionEntry {
  id           Int                   @id @default(autoincrement())
  restaurantId Int                   @map("restaurant_id")
  invoiceId    Int?                  @map("invoice_id")
  settlementId Int?                  @map("settlement_id")
  type         CommissionEntryType   @default(charge)
  status       CommissionEntryStatus @default(pending)

  baseAmount Decimal @map("base_amount") @db.Decimal(12, 2)
  amount     Decimal @db.Decimal(12, 2)

  // The rate is snapshotted here. Changing a restaurant's rate tomorrow never
  // rewrites what it already owed today.
  commissionType CommissionType @map("commission_type")
  commissionRate Decimal        @map("commission_rate") @db.Decimal(10, 2)

  // The day this entry is economically attributed to (the order's business
  // date for a charge, the day the refund was issued for a reversal) - what
  // a CommissionRun actually windows by.
  businessDate DateTime @map("business_date") @db.Date
  runId        Int?     @map("run_id")

  // Set only when businessDate's proper cycle window had already closed by
  // the time this entry was created - a late arrival. The entry itself still
  // lands in whatever run is open right now (runId); this just keeps the
  // trail to which cycle it was really earned in.
  originalRunId Int? @map("original_run_id")

  note String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  restaurant  Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  settlement  Settlement?    @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  run         CommissionRun? @relation("RunEntries", fields: [runId], references: [id], onDelete: SetNull)
  originalRun CommissionRun? @relation("RunAdjustments", fields: [originalRunId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
  @@index([runId])
  @@map("commission_entries")
}

enum CommissionRunStatus {
  open
  closed
}

// The business_date-windowed bucket a commission entry accrues into as
// orders happen. Settlement still does the finalise/pay step, sweeping one
// or more closed runs; a run never gets re-opened or re-sliced once closed.
model CommissionRun {
  id           Int                 @id @default(autoincrement())
  restaurantId Int                 @map("restaurant_id")
  cycleStart   DateTime            @map("cycle_start") @db.Date
  cycleEnd     DateTime            @map("cycle_end") @db.Date
  status       CommissionRunStatus @default(open)
  settlementId Int?                @map("settlement_id")

  grossSales      Decimal @default(0) @map("gross_sales") @db.Decimal(14, 2)
  commissionTotal Decimal @default(0) @map("commission_total") @db.Decimal(14, 2)
  entryCount      Int     @default(0) @map("entry_count")

  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  settlement  Settlement?       @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  entries     CommissionEntry[] @relation("RunEntries")
  adjustments CommissionEntry[] @relation("RunAdjustments")

  @@unique([restaurantId, cycleStart, cycleEnd])
  @@index([restaurantId, status])
  @@map("commission_runs")
}

enum SettlementStatus {
  open
  finalised
  paid
}

model Settlement {
  id               Int              @id @default(autoincrement())
  restaurantId     Int              @map("restaurant_id")
  settlementNumber String           @map("settlement_number") @db.VarChar(40)
  status           SettlementStatus @default(open)

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  grossSales      Decimal @default(0) @map("gross_sales") @db.Decimal(14, 2)
  commissionTotal Decimal @default(0) @map("commission_total") @db.Decimal(14, 2)
  entryCount      Int     @default(0) @map("entry_count")

  finalisedAt DateTime? @map("finalised_at")
  paidAt      DateTime? @map("paid_at")
  paymentRef  String?   @map("payment_ref") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  entries    CommissionEntry[]
  runs       CommissionRun[]

  @@unique([restaurantId, settlementNumber])
  @@map("settlements")
}

