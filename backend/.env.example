# ---------------------------------------------------------------- Application
NODE_ENV=development
PORT=8000
APP_NAME="Restaurant Platform"

# ------------------------------------------------------------------- Database
# Neon connection string. Copy it from the Neon dashboard.
# The pooled URL is used at runtime; the direct URL is used for migrations,
# because Prisma Migrate needs a session it can hold open.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/restaurant_platform?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/restaurant_platform?sslmode=require"

# ----------------------------------------------------------------------- Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------- Frontend
# Origins allowed to call this API from a browser, comma-separated.
# Must include the deployed frontend URL or every request is CORS-blocked.
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------- Platform commercial
# The terms every new restaurant is registered on. Config, not database:
# changing these affects NEW registrations only. Restaurants already on the
# platform keep the terms they signed up under.
PLATFORM_COMMISSION_TYPE=percentage
PLATFORM_COMMISSION_VALUE=5.0
PLATFORM_SETTLEMENT_FREQUENCY=weekly
PLATFORM_AUTO_ACTIVATE=true
PLATFORM_CURRENCY=PKR

# --------------------------------------------------------- Uploads (optional)
# Logo and image uploads. Leave blank to disable uploads entirely.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------------------- Seeding
# `npm run seed` always creates permissions, roles and the Super Admin.
# Set this to true (or run `npm run seed:demo`) to also create the two demo
# restaurants. Leave unset in production.
SEED_DEMO_DATA=false
