# Base URL of the API, including /api.
# Development: Vite proxies /api to localhost:8000, so this can stay relative.
# Production: the full origin of the deployed backend.
VITE_API_BASE_URL=/api

# Where this app lives. Used to build the QR links printed for tables, so in
# production it must be the public URL customers can actually reach.
VITE_PUBLIC_SITE_URL=http://localhost:5173

VITE_APP_NAME="Restaurant Platform"
