# Production values. Set these in Netlify:
#   Site settings -> Environment variables
#
# Do NOT commit the real file. Vite bakes these into the built JavaScript at
# build time, so anything here is publicly visible - never put a secret in a
# VITE_ variable.

# Full origin of the deployed Laravel API, including /api.
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Where the app itself lives. Used to build the QR links printed for tables,
# so this must be the public URL customers can actually reach.
VITE_PUBLIC_SITE_URL=https://yourdomain.netlify.app

VITE_APP_NAME="Restaurant Platform"
